Include ~/.orbstack/ssh/config

Host unifi
	HostName 192.168.1.1
	User root
	IdentityFile ~/.ssh/id_ed25519_unifi
	IdentitiesOnly yes
	IdentityAgent none
	HostKeyAlgorithms +ssh-rsa
	PubkeyAcceptedAlgorithms +ssh-rsa

Host qnap
	HostName 192.168.1.211
	User admin
	IdentityFile ~/.ssh/id_ed25519_qnap
	IdentitiesOnly yes
	IdentityAgent none

# ds9 — always-on Mac mini herdr host, reached over Tailscale. The bare name
# resolves through MagicDNS; HostName pins the tailnet IP so it still connects
# if MagicDNS is off. mosh in from a phone, or `herdr --remote ds9` from here.
Host ds9
	HostName 100.124.8.59
	User vikgamov

Host *
	IPQoS throughput
	# 1Password's SSH agent. ssh takes the FIRST value it obtains for a given
	# keyword, so this must stay a single Host * block — a second one listing
	# the app-group path (~/Library/Group Containers/2BUA8C4S2C.com.1password/
	# t/agent.sock) is dead config, never a fallback. It is also redundant:
	# ~/.1password/agent.sock is a symlink to exactly that path. On a fresh
	# machine, install 1Password and enable the agent to create it.
	IdentityAgent "~/.1password/agent.sock"
