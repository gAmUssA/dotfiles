{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/muse-glimmer:30b-mlx-ctx64k",
  "disabled_providers": ["openai", "anthropic"],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-coder:30b-ctx64k": {
          "name": "qwen3-coder 30b (64k, agentic default)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "muse-glimmer:30b-mlx-ctx64k": {
          "name": "muse-glimmer 30b MLX (64k)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "qwen3.8:27b-mlx-ctx64k": {
          "name": "qwen3.8 27b MLX (64k)",
          "limit": {
            "context": 65536,
            "output": 32768
          }
        },
        "flint:40b-a2b-mlx-nvfp4-ctx64k": {
          "name": "Flint 40b-a2b MLX nvfp4 (64k)",
          "limit": {
            "context": 65536,
            "output": 32768
          }
        },
        "flint:40b-a2b-ctx64k": {
          "name": "Flint 40b-a2b GGUF (64k)",
          "limit": {
            "context": 65536,
            "output": 32768
          }
        },
        "flint:40b-a2b-ctx256k": {
          "name": "Flint 40b-a2b GGUF (256k)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    },
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX (local, prefix cache + MTP)",
      "options": {
        "baseURL": "http://localhost:8000/v1"
      },
      "models": {
        "Qwen3.8-27B-oQ4e-mtp": {
          "name": "Qwen3.8 27B oQ4e MTP (oMLX)",
          "limit": {
            "context": 65536,
            "output": 32768
          }
        }
      }
    },
    "rec": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "rec (Recursive, local MLX)",
      "options": {
        "baseURL": "http://127.0.0.1:11500/v1",
        "apiKey": "{env:REC_API_KEY}"
      },
      "models": {
        "flint": {
          "name": "Flint (rec)",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  },
  "mcp": {
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey={env:TAVILY_API_KEY}",
      "enabled": true
    },
    "railway": {
      "command": [
        "railway",
        "mcp"
      ],
      "enabled": true,
      "type": "local"
    }
  }
}
