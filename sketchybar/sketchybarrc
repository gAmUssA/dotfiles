#!/usr/bin/env bash
# SketchyBar: AeroSpace workspaces only, as a small pill at the bottom edge.
# Linked to ~/.config/sketchybar by linkall.sh; `sketchybar --reload` applies.
#
# The macOS menu bar stays as it is, with Bartender managing its icons. Taking
# over the menu bar was tried and dropped: with auto-hide, the native bar slid
# in over SketchyBar and took the clicks; drawn over it, app menus needed a
# toggle; and on macOS 27 mirrored icons (alias items) came back hundreds of
# points wide, because the menu bar is now one window instead of one per icon.
# The bottom edge is free here: the Dock sits on the right and auto-hides.

PLUGINS="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"
FONT="JetBrainsMono Nerd Font"
APP_FONT="sketchybar-app-font:Regular:15.0"

# margin narrows the bar window itself to a centered pill (1728 - 2*480 = 768
# pt on the built-in display), so it covers only that strip, not the full edge.
# topmost=window keeps it above windows that reach the bottom edge.
sketchybar --bar position=bottom height=30 margin=480 y_offset=6 corner_radius=10 \
  color=$BAR_COLOR blur_radius=30 padding_left=6 padding_right=6 topmost=window sticky=on display=all

sketchybar --default \
  icon.font="$FONT:Bold:14.0" label.font="$APP_FONT" \
  icon.color=$ACCENT label.color=$WHITE \
  padding_left=2 padding_right=2 \
  icon.padding_left=8 icon.padding_right=4 label.padding_left=2 label.padding_right=8 \
  background.height=24 background.corner_radius=7

# Workspace items have no script: one controller redraws all four in a single
# call. aerospace.toml triggers aerospace_workspace_change on workspace AND
# focus changes (a window sent elsewhere changes focus, not workspace).
sketchybar --add event aerospace_workspace_change
for sid in 1 2 3 4; do
  sketchybar --add item "space.$sid" center \
    --set "space.$sid" icon="$sid" label.y_offset=-1 \
      background.color=$ITEM_BG background.drawing=off drawing=off \
      click_script="/opt/homebrew/bin/aerospace workspace $sid"
done
sketchybar --add item spaces center \
  --set spaces drawing=off updates=on script="$PLUGINS/spaces.sh" \
  --subscribe spaces aerospace_workspace_change front_app_switched system_woke

sketchybar --update
